# Copy to .env. It is gitignored.
#
# Only needed for `--stage youtube-ingest --diarize`. Every other stage runs
# without it.
#
# Both pyannote models are gated. Accept the terms for each, then create a read
# token:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# Browser origins allowed to call api.py directly. Empty by default: the
# intended caller is pythonapi, server to server, which proxies clip audio on to
# the browser itself.
VOICE_FACTORY_CORS_ALLOW_ORIGINS=

# Where to report job changes, so the orchestrator does not have to poll. Leave
# the URL unset to keep the old behaviour: jobs run the same, the orchestrator
# just finds out on its own timer instead.
#
# The token must match VOICE_WEBHOOK_TOKEN in the copilot_agent_network repo.
# Without a matching token every webhook comes back 401.
VOICE_ORCHESTRATOR_WEBHOOK_URL=http://localhost:8000
VOICE_WEBHOOK_TOKEN=
# How often a running training job reports its epoch and loss.
VOICE_PROGRESS_INTERVAL_SECONDS=30
